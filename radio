#!/usr/bin/env python3

import curses
import json
import os
import ssl
import subprocess
import sys
import urllib.parse
import urllib.request

# Cache file path in user's home directory
CACHE_FILE = os.path.expanduser("~/.radio_stations")

# 1. Clean style mapping to bypass messy crowdsourced tags
TAG_ALIASES = {
    "80s": ["80s", "80's", "1980s", "80er", "1980's", "80"],
    "90s": ["90s", "90's", "1990s", "90er", "1990's"],
    "classical": ["classical", "classic", "orchestral", "symphony"],
    "talk": ["talk", "news", "speech", "public service"],
}

CONFIG = {
    "preferred_styles": ["80s", "talk", "classical", "90s", "BFBS"],
    "styled_countries": ["GB", "BE", "NL", "CA", "CH"],
    "all_station_countries": ["FK", "BS", "GY", "SR"],
}

ssl_context = ssl._create_unverified_context()


def fetch_from_api():
  """Fetch stations dynamically from Radio-Browser API."""
  playlist = []
  seen_urls = set()

  # PART A: Fetch by preferred styles and aliases
  for style, aliases in TAG_ALIASES.items():
    if style not in CONFIG["preferred_styles"]:
      continue
    for tag in aliases:
      for country in CONFIG["styled_countries"]:
        params = urllib.parse.urlencode(
            {"tag": tag, "countrycode": country, "limit": 35, "hidebroken": "true"}
        )
        url = f"https://de1.api.radio-browser.info/json/stations/search?{params}"
        req = urllib.request.Request(
            url, headers={"User-Agent": "MinimalistTerminalRadio/1.0"}
        )

        try:
          with urllib.request.urlopen(
              req, context=ssl_context, timeout=3
          ) as response:
            stations = json.loads(response.read().decode())
            for s in stations:
              stream_url = s.get("url_resolved")
              if stream_url and stream_url not in seen_urls:
                seen_urls.add(stream_url)
                playlist.append(
                    {
                        "name": s["name"].strip(),
                        "style": style.upper(),
                        "country": country,
                        "url": stream_url,
                    }
                )
        except Exception:
          continue

  # PART B: Fetch ALL available stations for obscure countries
  for country in CONFIG["all_station_countries"]:
    params = urllib.parse.urlencode(
        {"countrycode": country, "limit": 10, "hidebroken": "true"}
    )
    url = f"https://de1.api.radio-browser.info/json/stations/search?{params}"
    req = urllib.request.Request(
        url, headers={"User-Agent": "MinimalistTerminalRadio/1.0"}
    )

    try:
      with urllib.request.urlopen(req, context=ssl_context, timeout=4) as response:
        stations = json.loads(response.read().decode())
        for s in stations:
          stream_url = s.get("url_resolved")
          if stream_url and stream_url not in seen_urls:
            seen_urls.add(stream_url)
            station_tags = (
                s.get("tags", "REGIONAL").split(",")[0].upper()
                if s.get("tags")
                else "REGIONAL"
            )
            playlist.append(
                {
                    "name": s["name"].strip(),
                    "style": station_tags,
                    "country": country,
                    "url": stream_url,
                }
            )
    except Exception:
      continue

  return playlist


def load_stations():
  """Load from cache file unless --refresh is passed or cache doesn't exist."""
  force_fetch = "--refresh" in sys.argv or "-r" in sys.argv

  if not force_fetch and os.path.exists(CACHE_FILE):
    try:
      with open(CACHE_FILE, "r") as f:
        return json.load(f)
    except Exception:
      pass  # Fallback to API if cache is corrupt

  # Otherwise fetch from API and write to cache
  stations = fetch_from_api()
  if stations:
    try:
      with open(CACHE_FILE, "w") as f:
        json.dump(stations, f, indent=2)
    except Exception:
      pass
  return stations


def main(stdscr):
  curses.curs_set(0)
  stdscr.keypad(1)

  if curses.has_colors():
    curses.start_color()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)

  # Check if we are reading from cache or hitting the network
  force_fetch = "--refresh" in sys.argv or "-r" in sys.argv
  msg = (
      "Refreshing stations from API..."
      if force_fetch or not os.path.exists(CACHE_FILE)
      else "Loading stations from local cache..."
  )

  stdscr.addstr(0, 2, msg)
  stdscr.refresh()

  stations = load_stations()
  if not stations:
    stdscr.clear()
    stdscr.addstr(
        0, 2, "No stations found. Check your internet connection. Press any key to"
        " exit."
    )
    stdscr.getch()
    return

  current_row = 0
  window_top = 0

  while True:
    stdscr.clear()
    height, width = stdscr.getmaxyx()

    max_display_rows = height - 3
    if max_display_rows < 1:
      max_display_rows = 1

    if current_row < window_top:
      window_top = current_row
    elif current_row >= window_top + max_display_rows:
      window_top = current_row - max_display_rows + 1

    title = "=== TERMINAL RADIO ([↑/↓] Navigate | [Enter] Play | [q] Quit) ==="
    stdscr.addstr(0, 2, title[: width - 2], curses.A_BOLD)

    visible_slice = stations[window_top : window_top + max_display_rows]

    for idx, station in enumerate(visible_slice):
      actual_idx = window_top + idx
      line_text = (
          f" {station['name']} [{station['style']} |"
          f" {station['country'].upper()}] "
      )

      if actual_idx == current_row:
        if curses.has_colors():
          stdscr.attron(curses.color_pair(1))
        else:
          stdscr.attron(curses.A_REVERSE)

        stdscr.addstr(idx + 2, 2, line_text[: width - 4])

        if curses.has_colors():
          stdscr.attroff(curses.color_pair(1))
        else:
          stdscr.attroff(curses.A_REVERSE)
      else:
        stdscr.addstr(idx + 2, 2, line_text[: width - 4])

    stdscr.refresh()

    key = stdscr.getch()

    if key == curses.KEY_UP:
      current_row = max(0, current_row - 1)
    elif key == curses.KEY_DOWN:
      current_row = min(len(stations) - 1, current_row + 1)
    elif key == ord("\n") or key == curses.KEY_ENTER:
      selected = stations[current_row]

      curses.endwin()
      print(f"\n▶ Streaming: {selected['name']} [{selected['style']}]")
      print("Press Ctrl+C once to return to the menu.\n")

      try:
        subprocess.run(["ffplay", "-nodisp", "-autoexit", selected["url"]])
      except KeyboardInterrupt:
        print("\nStopping stream...")

      stdscr.clear()
    elif key == ord("q") or key == ord("Q"):
      break


if __name__ == "__main__":
  curses.wrapper(main)